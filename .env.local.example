# Environment Configuration - Copy this file to .env.local and fill in your values

# =============================================================================
# GEMINI AI API - Required for AI Market Insights in Dashboard
# =============================================================================
# Get your API key from: https://ai.google.dev/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# reCAPTCHA v2 - Required for Registration Form
# =============================================================================
# Get your Site Key from: https://www.google.com/recaptcha/admin
# Create a NEW site with:
#   - reCAPTCHA Type: "reCAPTCHA v2"
#   - Verification Mode: "I'm not a robot" (Checkbox)
#   - Domains: localhost, 127.0.0.1, dev.detidex.yeuthich.net
# COPY the "Site Key" value below (not the Secret Key)
VITE_RECAPTCHA_SITE_KEY=6Ld3ZREsAAAAAFcoDEP3w6yJug9y7cT9NTkyt_jT

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Backend API domain for live trading endpoints
VITE_API_DOMAIN=https://detidex.yeuthich.net

# =============================================================================
# DEBUG CONFIGURATION
# =============================================================================
# Set to 'true' for verbose console logging (auth tokens masked, API calls traced)
VITE_DEBUG=false
